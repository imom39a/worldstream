{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WorldStream Room Setup Specification v1",
  "description": "Non-authoritative creation intent. Principal references allocate new identities once per operation, not existing Principal lookups.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "pack",
    "configuration",
    "seats"
  ],
  "properties": {
    "schema": {
      "const": "worldstream/room-setup/v1"
    },
    "pack": {
      "$ref": "#/$defs/pack"
    },
    "configuration": {
      "description": "Resolved against the exact installed Pack schema; semantic acceptance remains the Pack's responsibility."
    },
    "seats": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/seat"
      }
    },
    "operator_view": {
      "type": "boolean",
      "default": false
    }
  },
  "$defs": {
    "pack": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "digest"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "digest": {
          "type": "string",
          "pattern": "^blake3:[0-9a-f]{64}$"
        }
      }
    },
    "principal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference",
        "kind"
      ],
      "properties": {
        "reference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "kind": {
          "enum": [
            "human",
            "agent"
          ]
        }
      }
    },
    "assignment": {
      "type": "object",
      "additionalProperties": false,
      "if": {
        "properties": { "mode": { "const": "managed" } },
        "required": ["mode"]
      },
      "then": { "required": ["agent_profile", "runner_template"] },
      "else": { "not": { "required": ["runner_template"] } },
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "enum": [
            "external",
            "managed"
          ]
        },
        "agent_profile": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "profile_id",
            "revision"
          ],
          "properties": {
            "profile_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[a-z0-9][a-z0-9_-]*$"
            },
            "revision": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
            }
          }
        },
        "runner_template": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "template_id",
            "revision"
          ],
          "properties": {
            "template_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[a-z0-9][a-z0-9_-]*$"
            },
            "revision": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
            }
          }
        }
      }
    },
    "seat": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "role",
        "required",
        "display_name"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "role": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "required": {
          "type": "boolean"
        },
        "display_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "principal": {
          "anyOf": [
            {
              "$ref": "#/$defs/principal"
            },
            {
              "type": "null"
            }
          ]
        },
        "assignment": {
          "anyOf": [
            {
              "$ref": "#/$defs/assignment"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
