NODE_ENV=production
WORLDSTREAM_DEPLOYMENT_ENVIRONMENT=production
CANONICAL_ORIGIN=https://replace-with-production-origin.example
SUPABASE_URL=https://replace-with-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key
SUPABASE_DATA_SECRET_KEY=replace-with-secret-key
WORLDSTREAM_SESSION_KEY_BASE64=replace-with-exact-32-byte-base64-key
WORLDSTREAM_OAUTH_KEY_BASE64=replace-with-separate-exact-32-byte-base64-key
WORLDSTREAM_HOSTED_GATEWAY_URL=https://replace-with-fly-app.example
WORLDSTREAM_VERCEL_SERVICE_AUTHORITY=replace-with-shared-fly-service-authority
# This formation identity must match the Fly appliance and the active House
# approvals. It is not the global platform operating-row identity.
WORLDSTREAM_HOSTED_INSTALLATION_ID=fly-primary-r3
# Optional, server-only rollout switch for the reviewed unlisted candidate.
# Omit it to serve only the public library. No other digest is accepted.
WORLDSTREAM_INTERNAL_CANDIDATE_LISTING_DIGEST=blake3:cc1c92ebc6ba7cccc9474186ff8107cf97f6bd0ce2676c6d1a2aa203c2a62d35
CRON_SECRET=replace-with-separate-random-32-character-minimum-secret
# Enable Vercel system environment variables. VERCEL_GIT_COMMIT_SHA and
# VERCEL_DEPLOYMENT_ID must describe the actual deployment (do not hand-set them).
