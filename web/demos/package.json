{
  "name": "@worldstream/demos",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.18.1"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5180",
    "build": "pnpm --dir ../../clients/agent-heist-web build && tsc --noEmit && vite build && node ../../scripts/install-hosted-client-artifacts.mjs",
    "lint": "tsc --noEmit",
    "test": "vitest run --environment node"
  },
  "dependencies": {
    "@worldstream/agent-heist-client": "workspace:*",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}
