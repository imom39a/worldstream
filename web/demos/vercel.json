{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist",
  "functions": {
    "api/**/*.mjs": {
      "maxDuration": 300
    }
  },
  "crons": [{ "path": "/api/internal/reconcile", "schedule": "0 8 * * *" }],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://avatars.githubusercontent.com; font-src 'self' data:; connect-src 'self' wss://worldstream-preview.fly.dev; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/agent-heist/:path*",
      "destination": "/api/platform"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/platform"
    },
    {
      "source": "/join",
      "destination": "/index.html"
    },
    {
      "source": "/launches/:launch_id",
      "destination": "/index.html"
    },
    {
      "source": "/my-games",
      "destination": "/index.html"
    },
    {
      "source": "/runs/:public_id",
      "destination": "/index.html"
    },
    {
      "source": "/demos/agent-heist",
      "destination": "/demos/agent-heist/index.html"
    },
    {
      "source": "/docs/agent-heist",
      "destination": "/docs/agent-heist/index.html"
    }
  ]
}
