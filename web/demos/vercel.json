{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/runs/:public_id",
      "destination": "/index.html"
    },
    {
      "source": "/demos/agent-heist",
      "destination": "/demos/agent-heist/index.html"
    },
    {
      "source": "/docs/agent-heist",
      "destination": "/docs/agent-heist/index.html"
    }
  ]
}
