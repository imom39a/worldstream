SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key
SUPABASE_DATA_SECRET_KEY=replace-with-local-secret-key
SUPABASE_AUTH_ADMIN_SECRET_KEY=replace-with-separate-local-admin-secret-key
WORLDSTREAM_SESSION_KEY_BASE64=replace-with-32-byte-base64-key
