{
  "name": "worldstream-workspace",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0+sha512.7881f3ed590d472c4a955e2b88b2121791116066dcc88cbca3849ec9b60f1bbaa6d2ccb221fa91da4e1c65bef2bcbe379365aea7ac539c7bf86dedc3a1b22dce",
  "engines": {
    "node": "24.18.1"
  },
  "scripts": {
    "docs:dev": "pnpm --dir web/manual dev",
    "docs:build": "pnpm --dir web/manual build",
    "docs:lint": "pnpm --dir web/manual lint",
    "docs:test": "pnpm --dir web/manual test",
    "docs:verify": "node scripts/verify-developer-manual.mjs",
    "docs:preview": "pnpm --dir web/manual preview",
    "demos:dev": "pnpm --dir web/demos dev",
    "demos:build": "pnpm --dir web/demos build",
    "demos:lint": "pnpm --dir web/demos lint",
    "demos:test": "pnpm --dir web/demos test",
    "heist-client:dev": "pnpm --dir clients/agent-heist-web dev",
    "heist-client:build": "pnpm --dir clients/agent-heist-web build",
    "heist-client:lint": "pnpm --dir clients/agent-heist-web lint",
    "heist-client:test": "pnpm --dir clients/agent-heist-web test",
    "negotiate-client:dev": "pnpm --dir clients/negotiate-web dev",
    "negotiate-client:build": "pnpm --dir clients/negotiate-web build",
    "negotiate-client:lint": "pnpm --dir clients/negotiate-web lint",
    "negotiate-client:test": "pnpm --dir clients/negotiate-web test",
    "activity-clients:build": "pnpm heist-client:build && pnpm negotiate-client:build && pnpm studio:build && pnpm ui:build",
    "activity-clients:check": "pnpm heist-client:lint && pnpm heist-client:test && pnpm negotiate-client:lint && pnpm negotiate-client:test && pnpm --dir web/studio lint && pnpm studio:test && pnpm ui:lint && pnpm ui:test",
    "activity-clients:rust": "cargo test -p worldstream-activity-client && cargo test -p worldstream-studio-supervisor --test client_bindings && cargo test -p worldstream-studio-supervisor --test participant_handoff",
    "activity-clients:docs": "pnpm docs:verify && pnpm docs:lint && pnpm docs:test && pnpm docs:build",
    "activity-clients:format": "cargo fmt --all -- --check",
    "activity-clients:workspace": "CARGO_INCREMENTAL=0 cargo test --workspace -j 1",
    "activity-clients:browser": "node scripts/verify-activity-client-browser.mjs",
    "activity-clients:serve": "pnpm activity-clients:build && node scripts/serve-activity-clients.mjs",
    "activity-clients:verify": "pnpm activity-clients:format && pnpm activity-clients:check && pnpm activity-clients:build && pnpm activity-clients:rust && pnpm activity-clients:docs && pnpm activity-clients:workspace && node scripts/verify-activity-clients.mjs && pnpm activity-clients:browser",
    "studio:prototype": "pnpm --dir web/console prototype:studio",
    "studio:dev": "scripts/studio-dev.sh",
    "studio:supervisor": "cargo run -p worldstream-studio-supervisor --bin worldstream-studio-supervisor --",
    "counter:studio": "sdk/python/.venv/bin/python examples/counter/run_studio_demo.py",
    "counter:studio:browser": "node examples/counter/run_studio_browser_acceptance.mjs",
    "negotiate:acceptance": "uv run --project sdk/python --python 3.14.7 python scripts/negotiate-golden-flow.py",
    "pack:build": "pnpm --filter @worldstream/pack-sdk build && pnpm --filter @worldstream/pack-cli build",
    "pack:lint": "pnpm --filter @worldstream/pack-sdk lint && pnpm --filter @worldstream/pack-cli lint",
    "pack:test": "pnpm --filter @worldstream/pack-sdk test && pnpm --filter @worldstream/pack-cli test",
    "studio:build": "pnpm --dir web/studio build",
    "studio:test": "pnpm --dir web/studio test",
    "ui:dev": "pnpm activity-clients:serve",
    "ui:source-dev": "pnpm --dir web/console dev",
    "ui:build": "pnpm --dir web/console build",
    "ui:lint": "pnpm --dir web/console lint",
    "ui:test": "pnpm --dir web/console test"
  },
  "devDependencies": {
    "playwright": "1.62.1"
  }
}
