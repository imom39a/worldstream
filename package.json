    "counter:studio:browser": "node examples/counter/run_studio_browser_acceptance.mjs",
    "studio:build": "pnpm --dir web/studio build",
    "studio:test": "pnpm --dir web/studio test",
    "ui:dev": "pnpm --dir web/console dev",
    "ui:build": "pnpm --dir web/console build",
    "ui:lint": "pnpm --dir web/console lint",
    "ui:test": "pnpm --dir web/console test"
  },
  "devDependencies": {
    "playwright": "1.62.1"
  }
}
