      "enum": [
        "nonterminal",
        "terminal"
      ]
    },
    "session_deadline": {
      "maxLength": 30,
      "minLength": 4,
      "type": "string"
    },
    "location": {
      "enum": [
        "atrium",
        "records",
        "conservation",
        "plant",
        "vault"
      ]
    },
    "outcome": {
