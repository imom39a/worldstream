        },
        {
          "kind": "partial_extraction"
        },
        {
          "kind": "wrong_ledger"
        },
        {
          "kind": "no_ledger"
        },
        {
          "kind": "exhausted_inside"
        }
      ]
    },
    "phase": {
      "enum": [
        "briefing",
        "active",
        "complete",
        "expired"
      ]
