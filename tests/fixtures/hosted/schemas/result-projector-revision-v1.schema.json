{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://worldstream.dev/schemas/result-projector-revision-v1.schema.json",
  "title": "WorldStream Result Projector Revision v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "projector_id", "version", "runtime", "input", "program", "output", "maximum_input_bytes"],
  "properties": {
    "schema": {"const": "worldstream/result-projector-revision/v1"},
    "projector_id": {"$ref": "#/$defs/identifier"},
    "version": {"$ref": "#/$defs/version"},
    "runtime": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "version", "digest"],
      "properties": {
        "id": {"const": "worldstream.result-projector.declarative"},
        "version": {"const": "1.0.0"},
        "digest": {"$ref": "#/$defs/blake3"}
      }
    },
    "input": {
      "type": "object", "additionalProperties": false,
      "required": ["pack", "listing_schema", "complete_head_schema", "projection"],
      "properties": {
        "pack": {"$ref": "#/$defs/pack"},
        "listing_schema": {"const": "worldstream/activity-listing-revision/v1"},
        "complete_head_schema": {"const": "worldstream/complete-head/v1"},
        "projection": {"$ref": "#/$defs/schema_reference"}
      }
    },
    "program": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "terminal", "outcome_field", "summary_fields"],
      "properties": {
        "schema": {"const": "worldstream/result-projector-program/v1"},
        "terminal": {
          "type": "object", "additionalProperties": false,
          "required": ["field", "equals"],
          "properties": {"field": {"$ref": "#/$defs/json_key"}, "equals": {"type": "string", "minLength": 1, "maxLength": 64}}
        },
        "outcome_field": {"$ref": "#/$defs/json_key"},
        "summary_fields": {
          "type": "array", "minItems": 1, "maxItems": 32,
          "items": {
            "oneOf": [
              {
                "type": "object", "additionalProperties": false,
                "required": ["output", "source", "kind", "values"],
                "properties": {"output": {"$ref": "#/$defs/json_key"}, "source": {"$ref": "#/$defs/json_key"}, "kind": {"const": "enum"}, "values": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128}}}
              },
              {
                "type": "object", "additionalProperties": false,
                "required": ["output", "source", "kind", "maximum_bytes"],
                "properties": {"output": {"$ref": "#/$defs/json_key"}, "source": {"$ref": "#/$defs/json_key"}, "kind": {"const": "nullable_identifier"}, "maximum_bytes": {"type": "integer", "minimum": 1, "maximum": 128}}
              },
              {
                "type": "object", "additionalProperties": false,
                "required": ["output", "source", "kind", "minimum", "maximum"],
                "properties": {"output": {"$ref": "#/$defs/json_key"}, "source": {"$ref": "#/$defs/json_key"}, "kind": {"const": "integer"}, "minimum": {"type": "integer", "minimum": 0, "maximum": 4294967295}, "maximum": {"type": "integer", "minimum": 0, "maximum": 4294967295}}
              }
            ]
          }
        }
      }
    },
    "output": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "schema_digest", "canonicalizer", "maximum_bytes"],
      "properties": {
        "schema": {"$ref": "#/$defs/identifier"},
        "schema_digest": {"$ref": "#/$defs/blake3"},
        "canonicalizer": {"const": "worldstream/canonical-json/v1"},
        "maximum_bytes": {"type": "integer", "minimum": 128, "maximum": 16384}
      }
    },
    "maximum_input_bytes": {"type": "integer", "minimum": 1, "maximum": 262144}
  },
  "$defs": {
    "identifier": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"},
    "json_key": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "version": {"type": "string", "minLength": 1, "maxLength": 32, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "blake3": {"type": "string", "pattern": "^blake3:[0-9a-f]{64}$"},
    "pack": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "version", "digest"],
      "properties": {"id": {"$ref": "#/$defs/identifier"}, "version": {"$ref": "#/$defs/version"}, "digest": {"$ref": "#/$defs/blake3"}}
    },
    "schema_reference": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "digest"],
      "properties": {"schema": {"$ref": "#/$defs/identifier"}, "digest": {"$ref": "#/$defs/blake3"}}
    }
  }
}
