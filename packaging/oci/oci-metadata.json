{
  "artifact": "worldstream-oci/v1",
  "base_image": {
    "digest": "",
    "status": "must_be_pinned_by_release_evidence"
  },
  "profile": "oci-linux-amd64",
  "filesystem_policy": {
    "sqlite_allowed": [
      "ext4",
      "xfs"
    ],
    "sqlite_rejected": [
