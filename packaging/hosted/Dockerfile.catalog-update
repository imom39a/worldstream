# syntax=docker/dockerfile:1.7
#
# A bounded Controller catalog overlay for the reviewed Agent Heist v9 Listing.
# It deliberately starts from the exact deployed appliance and replaces neither
# the Runtime nor any managed-agent executable or its retained digest.
ARG WORLDSTREAM_DEPLOYED_RUNTIME_IMAGE=registry.fly.io/worldstream-preview@sha256:8d5a44b2d547b1f0bb970bf2d9a67ba7db4fd7ea66840e93a4e1e1f29a1f0f07
ARG WORLDSTREAM_CONTROLLER_BUILDER_IMAGE

FROM ${WORLDSTREAM_CONTROLLER_BUILDER_IMAGE} AS controller-builder

FROM ${WORLDSTREAM_DEPLOYED_RUNTIME_IMAGE}

ARG WORLDSTREAM_DEPLOYED_RUNTIME_IMAGE
ARG WORLDSTREAM_CONTROLLER_BUILDER_IMAGE
ARG CONTROLLER_SOURCE_REVISION

LABEL io.worldstream.base-image="${WORLDSTREAM_DEPLOYED_RUNTIME_IMAGE}" \
      io.worldstream.controller-builder-image="${WORLDSTREAM_CONTROLLER_BUILDER_IMAGE}" \
      io.worldstream.controller-source-revision="${CONTROLLER_SOURCE_REVISION}" \
      io.worldstream.catalog-update.scope="controller-catalog-and-reviewed-client-assets-only"

# The builder is a separately verified, clean source archive.  Consume only its
# Controller binary; all Runtime, Gateway, MCP, and managed-agent-host bytes
# remain inherited from the digest-pinned deployed appliance.
COPY --from=controller-builder /src/target/release/worldstream-studio-supervisor /usr/local/bin/worldstream-studio-supervisor

# These are the complete initialization assets required for Listing 0.26's v9
# client binding.  Retained v8/v7 metadata stays available for existing Rooms.
COPY scripts/hosted-runtime.mjs /opt/worldstream/hosted/hosted-runtime.mjs
COPY config/activity-clients/releases/agent-heist-web-v9.json /opt/worldstream/hosted/agent-heist-web.json
COPY config/activity-clients/releases/agent-heist-web-v8.json /opt/worldstream/hosted/agent-heist-web-v8.json
COPY config/activity-clients/releases/agent-heist-web-v7.json /opt/worldstream/hosted/agent-heist-web-v7.json
COPY config/activity-clients/hosted-local-bindings.json /opt/worldstream/hosted/activity-client-bindings.json

RUN chmod 0755 /usr/local/bin/worldstream-studio-supervisor \
    && chmod 0644 /opt/worldstream/hosted/hosted-runtime.mjs \
      /opt/worldstream/hosted/agent-heist-web.json \
      /opt/worldstream/hosted/agent-heist-web-v8.json \
      /opt/worldstream/hosted/agent-heist-web-v7.json \
      /opt/worldstream/hosted/activity-client-bindings.json
