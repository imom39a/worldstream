# Non-secret deployment bindings. Set these with `fly deploy --env`.
WORLDSTREAM_DEPLOYMENT_VERSION=<clean-git-commit>
WORLDSTREAM_PUBLIC_AUTHORITY=<fly-app>.fly.dev
WORLDSTREAM_HOSTED_CLIENT_ORIGIN=https://<product-domain>

# Secret values. Install these with `fly secrets set`; never put values here.
WORLDSTREAM_AUTHORITY_BOOTSTRAP_SECRET=<at-least-32-random-visible-characters>
WORLDSTREAM_HOSTED_CONTROLLER_AUTHORITY=<at-least-32-random-visible-characters>
WORLDSTREAM_VERCEL_SERVICE_AUTHORITY=<same-secret-configured-on-the-vercel-bff>
OPENROUTER_API_KEY=<bounded-house-provider-key>
