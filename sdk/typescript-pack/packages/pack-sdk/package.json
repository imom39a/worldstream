{
  "name": "@worldstream/pack-sdk",
  "version": "0.1.0",
  "description": "Deterministic TypeScript authoring primitives for WorldStream Activity Packs",
  "type": "module",
  "engines": {
    "node": "24.18.1"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run build && node --test dist/index.test.js"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "typescript": "5.9.2"
  }
}
