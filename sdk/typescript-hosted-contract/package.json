{
  "name": "@worldstream/hosted-contract",
  "version": "0.1.0",
  "private": true,
  "description": "Bounded hosted-platform listing, launch, and result contracts",
  "type": "module",
  "engines": {
    "node": "24.18.1"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "prebuild": "pnpm --filter @worldstream/pack-sdk build",
    "build": "tsc -p tsconfig.build.json",
    "prelint": "pnpm --filter @worldstream/pack-sdk build",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run build && node --test dist/index.test.js"
  },
  "dependencies": {
    "@worldstream/pack-sdk": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "typescript": "5.9.2"
  }
}
